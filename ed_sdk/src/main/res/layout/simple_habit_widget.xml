<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simple_widget_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_habit_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Habit Name"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_habit_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description"
        android:textColor="#AAFFFFFF"
        android:textSize="14sp"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:ellipsize="end"
        android:layout_marginTop="1dp" />

    <ImageView
        android:id="@+id/widget_consistency_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_marginEnd="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="🔥 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_done_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✓ 0 days"
            android:textColor="#AAFFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/widget_checkin_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitXY" />

    </LinearLayout>
</LinearLayout>
